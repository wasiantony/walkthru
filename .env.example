# Copy to .env and adjust. Never commit .env.

# Postgres (used by docker compose and by `npm run dev` against the compose database)
POSTGRES_USER=walkthrough
POSTGRES_PASSWORD=walkthrough_dev
POSTGRES_DB=walkthrough
DATABASE_URL=postgresql://walkthrough:walkthrough_dev@localhost:5432/walkthrough

# Screenshot storage. "local" writes to STORAGE_DIR. (S3-compatible driver to come.)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
